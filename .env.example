# Flask Configuration
SECRET_KEY=replace-with-a-random-secret-key
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adaptivelearn_db

# Fallback & Demo Mode
# If MySQL server is unreachable, automatically uses local SQLite storage for seamless demo execution
USE_SQLITE_FALLBACK=True
DEMO_MODE=True

# Mastery Gating Default Threshold (Percent)
MASTERY_THRESHOLD=70

# AI Configuration (Gemini API)
# Leave empty to run in deterministic offline Demo Mode
GEMINI_API_KEY=

# YouTube Data API v3 Key
# Leave empty to use verified educational playlist fallbacks
YOUTUBE_API_KEY=
